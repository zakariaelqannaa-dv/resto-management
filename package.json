{
  "name": "resto-managment",
  "private": true,
  "version": "0.1.0",
  "description": "Mise — restaurant menu, floor, orders and kitchen ticket board",
  "author": "Zakaria Elqannaa (zakariaelqannaa-dv)",
  "license": "MIT",
  "homepage": "https://github.com/zakariaelqannaa-dv/resto-management#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakariaelqannaa-dv/resto-management.git"
  },
  "bugs": {
    "url": "https://github.com/zakariaelqannaa-dv/resto-management/issues"
  },
  "main": "desktop/main.cjs",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run build && npm run start --workspace server",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
